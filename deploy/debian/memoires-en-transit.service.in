[Unit]
Description=Memoires en transit / Proto 07 (8 HP)
After=sound.target network-online.target
Wants=sound.target

[Service]
Type=simple
WorkingDirectory=MET_ROOT_PLACEHOLDER
ExecStart=MET_ROOT_PLACEHOLDER/deploy/debian/launch.sh --nogui
Restart=on-failure
RestartSec=4
Nice=-10

[Install]
WantedBy=multi-user.target
